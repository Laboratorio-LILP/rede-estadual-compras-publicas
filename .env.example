# Porta do servidor em dev local sem Docker (padrão: 3001)
PORT=3001

# Secret para assinar tokens JWT (OBRIGATÓRIO — no Docker o compose falha sem ele;
# gere um valor único com: openssl rand -hex 32).
# Com NODE_ENV=production o servidor recusa subir sem esta variável. Fora de
# produção, gera um segredo aleatório por processo — as sessões caem a cada
# reinício, e nenhum segredo fixo fica versionado.
JWT_SECRET=seu-secret-seguro-aqui

# Caminho do banco SQLite em dev local (padrão: server/forum.db).
# No Docker o compose já define /data/forum.db (volume nomeado) — não configure aqui.
DB_PATH=server/forum.db

# Chave da YouTube Data API v3 (necessária para importar playlists de capacitação).
# Sem ela a importação fica desligada e diz isso — não há mais chamada sem
# credencial. A chave viaja no cabeçalho X-goog-api-key, nunca na URL.
YOUTUBE_API_KEY=sua-api-key-aqui

# Senha do admin criado no primeiro boot (banco vazio).
# Em produção, sem esta variável o servidor sorteia uma senha e a imprime UMA
# ÚNICA VEZ no log do boot. Fora de produção, usa a senha padrão de dev.
ADMIN_PASSWORD=

# Semear os dados de demonstração (5 contas de teste + 15 tópicos fictícios).
# Padrão: ligado fora de produção, desligado em produção.
# 1 força ligado, 0 força desligado.
SEED_DEMO_DATA=

# Senha das contas de demonstração (padrão: teste123). Só tem efeito quando
# SEED_DEMO_DATA está ligado.
DEMO_PASSWORD=

# Confiança em proxy reverso, no formato aceito pelo Express (padrão: loopback).
# Define de onde req.ip é lido. Errado aqui, o rate limit de login conta todos
# os usuários como um IP só e trava o acesso de todo mundo.
TRUST_PROXY=loopback

# --- Docker (compose lilp-recpsp) ---

# Porta no host, em loopback (padrão: 8003 — BDLP usa 8000/8080, PESCP usa 8002)
RECPSP_PORT=8003

# Origens aceitas pelo CORS, separadas por vírgula.
# Se mudar RECPSP_PORT, ajuste aqui também. Sem a variável, o servidor usa a
# lista original do código (localhost:3000/3001 + recpsp.onrender.com).
ALLOWED_ORIGINS=http://localhost:8003,http://127.0.0.1:8003
