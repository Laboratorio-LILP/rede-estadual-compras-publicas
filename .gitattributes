# Normalização de fim de linha (ADR-004 transversal, atualização de 27/08/2026).
# Código que roda em contêiner Linux é sempre LF; scripts Windows são CRLF.
* text=auto

*.sh       text eol=lf
Dockerfile text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.py       text eol=lf
*.sql      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.json     text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.md       text eol=lf
*.toml     text eol=lf
*.svg      text eol=lf

*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.docx binary
